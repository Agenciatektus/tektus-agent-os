# analise-conta-midia-cliente — credenciais
#
# Copie para _secrets/analise-midia.env e preencha. O arquivo fica fora do git.
# Nenhuma destas credenciais exige acesso a servidor.

# OBRIGATÓRIA — System User token da Business Manager, escopo ads_read
# Business Manager > Configurações > Usuários do sistema > Gerar token
META_ACCESS_TOKEN=

# OPCIONAL — acervo de posts do perfil no Instagram
# Console da Apify > Settings > Integrations
APIFY_TOKEN=

# OPCIONAL — consulta a matriz_meta como complemento
# Use a chave anon. A service_role atravessa o isolamento entre agências
# e não é necessária para esta skill.
VERDASH_SUPABASE_URL=
VERDASH_SUPABASE_KEY=
